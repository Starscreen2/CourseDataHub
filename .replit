modules = ["python-3.12"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "rapidfuzz-cpp", "taskflow"]

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "python main.py"]

[workflows]

[[workflows.workflow]]
name = "Flask Server"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
